$"hello_world = \"Hello world!\""
$"error = \"error!\\n\""
$"serial_addr = 0xE0300000"

halt

print_hw:

set32 r30 $"serial_addr"
apc r31 (hello_world + 4) 
store r30 r31 0x00
add r31 r0 $"len(hello_world)"
store r30 r31 0x04
add r31 r0 1 # apply print
store r30 r31 0x0C
ret

hello_world:
.datac  $"hello_world"
Error:
.datac  $"error"
