halt
start:
call print_hw

apc r20 temp_interrupt_table 
sysw r20 1 # set IVT adress 


or r30 r0 0b10000# Mask all interrupts except the disk 
sysw r20 2 # set IMR register
        

apc r21 temp_disk_interrupt  # Setup Disk Interrupts
store r20 r21 4 # *(IVT + 4) = temp_disk_interrupt 


# Enable interrupts
or r30 r0 0b11 # Kernel privelages + interrupts enabled
sysw r30 0 


# Read First Block From Disk
        set32 r12 0xE0000000 # base disk addr
        
        or r31 r0 0 # base_block_index
        store r12 r31 0 
        
        or r11 r0 0x6000 # buffer_address(idk. some random addr, this doesn't matter)
        store r12 r11 0x04 

        or r31 r0 1 # block_count
        store r12 r31 0x08 

        or r31 r0 0 # core_id_to_interrupt 
        store r12 r31 0x0C 

        or r31 r0 0 # control: read, 0 command id
        store r12 r31 0x14 
        halt # await for disk interrupt

call print_hw # Should've seen HW 3 times in the console  

halt

        

# Check Magic Number
# Load Boot Code Blocks From Disk
# Jump To First Byte Of The Boot Code
halt

temp_disk_interrupt:
call print_hw
ret # Normal return to carry the privelages


temp_interrupt_table:
