$"base_disk_addr = 0xE0000000"
$"buffer_address = 0x6000"

halt
start:
call print_hw

apc r20 temp_interrupt_table 
sysw r20 1 # set IVT adress 

apc r21 temp_disk_interrupt  # Setup Disk Interrupts
store r20 r21 16 # *(IVT + 4 * 4) = temp_disk_interrupt 


# Enable interrupts
or r30 r0 0b11 # Kernel privelages + interrupts enabled
sysw r30 0 


# Read First Block From Disk
        set32 r12 $"base_disk_addr" # base disk addr
        
        or r31 r0 0 # base_block_index
        store r12 r31 0 
        
        or r11 r0 $"buffer_address" # buffer_address(idk. some random addr, this doesn't matter)
        store r12 r11 0x04 

        or r31 r0 1 # block_count
        store r12 r31 0x08 

        or r31 r0 0 # core_id_to_interrupt 
        store r12 r31 0x0C 

        or r31 r0 0 # control: read, 0 command id
        store r12 r31 0x14 
        halt # await for disk interrupt

# Enable back interrupts
or r30 r0 0b11 # Kernel privelages + interrupts enabled
sysw r30 0 

# Acknowladge the Interrupt
or r31 r0 0b01 # control: read, 1 command id
store r12 r31 0x14 

call print_hw   


or r11 r0 $"buffer_address" # buffer_address(idk. some random addr, this doesn't matter)
load r30 r11 0x00 # Magic Number 
# TODO: change serial printing impl

# TODO: check Magic Number
# TODO: load Boot Code Blocks From Disk
# TODO: jump To First Byte Of The Boot Code


halt

halt
temp_disk_interrupt:
sysr r2 3 # load EPC to normal return register
add r2 r2 -4
ret # Normal return to carry the privelages
ret # Normal return to carry the privelages


temp_interrupt_table: 
# Alloc some space for the temporary interrupt table
halt
halt
halt
halt
halt
halt
halt
halt
halt
halt
halt
halt
